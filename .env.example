# API Keys for the multi-model grading council
# Need at least 2 keys for the grading council to work

# Anthropic Claude (required)
ANTHROPIC_API_KEY=your_anthropic_key_here
# Alternative key name also supported:
# CLAUDE=your_anthropic_key_here

# OpenAI GPT (required)
OPENAI_API_KEY=your_openai_key_here

# Google Gemini (optional - can run with just 2 models)
GOOGLE_API_KEY=your_google_key_here
